@startuml architecture_conception
' ==============================================================
'  PlainteCam — Architecture globale de conception
'  Les modules de la solution et leurs connexions.
'  Aucune technologie n'y figure : c'est la vue conceptuelle.
' ==============================================================

skinparam dpi 150
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam ArrowColor #006432
skinparam ArrowThickness 1.3
skinparam nodesep 30
skinparam ranksep 40
skinparam linetype ortho

skinparam rectangle {
  BorderColor #006432
  BorderThickness 1.4
  FontColor #0B3A22
  RoundCorner 10
}

rectangle "MODULES DE SAISIE" as G1 #F3F9F5 {
  rectangle "**Saisie guidée**\n<size:10>Parcours en 5 étapes</size>" as M1 #FFFFFF
  rectangle "**Analyse de la déclaration**\n<size:10>Taux de complétude</size>\n<size:10>Questionnaire adaptatif</size>" as M2 #FFFFFF
  rectangle "**Référentiel territorial**\n<size:10>Cascade géographique</size>\n<size:10>Commissariat compétent</size>" as M3 #FFFFFF
}

rectangle "**DOSSIER DE PLAINTE**\n<size:10>Noyau du modèle : état, qualifications,</size>\n<size:10>préjudices, pièces, intervenants</size>" as CORE #FFF7E8

rectangle "MODULES D'INSTRUCTION" as G2 #F3F9F5 {
  rectangle "**Cotation**\n<size:10>Désignation de l'enquêteur</size>\n<size:10>et de la priorité</size>" as M4 #FFFFFF
  rectangle "**Étapier**\n<size:10>Cycle de vie et actes requis</size>" as M5 #FFFFFF
  rectangle "**Rédaction assistée**\n<size:10>Proposition de procès-verbal</size>" as M6 #FFFFFF
}

rectangle "MODULES TRANSVERSES" as G3 #F3F9F5 {
  rectangle "**Contrôle d'accès**\n<size:10>Identification et cloisonnement</size>" as M7 #FFFFFF
  rectangle "**Production de documents**\n<size:10>Récépissé, convocation, PV</size>" as M8 #FFFFFF
  rectangle "**Traçabilité**\n<size:10>Journal d'audit horodaté</size>" as M9 #FFFFFF
  rectangle "**Notification**\n<size:10>Information du plaignant</size>" as M10 #FFFFFF
}

M1 --> M2
M1 --> M3
M2 --> CORE
M3 --> CORE

CORE --> M4
M4  --> M5
M5  --> M6
M6  --> M8

M7 --> CORE : <size:10>filtre</size>
CORE --> M9 : <size:10>alimente</size>
M9 --> M10

@enduml
